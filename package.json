{
  "name": "poofpad",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted, real-time shared text pad that disappears at a chosen expiry.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "run-s build:client dev:all",
    "dev:all": "run-p dev:client dev:worker",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "run-s types build:client",
    "build:client": "vite build",
    "types": "wrangler types",
    "typecheck": "run-s types typecheck:tsc",
    "typecheck:tsc": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "run-s build vitest",
    "vitest": "vitest run",
    "test:e2e": "run-s test:e2e:main test:e2e:webkit",
    "test:e2e:main": "playwright test --project=chromium --project=firefox --project=pixel-7",
    "test:e2e:webkit": "playwright test --project=webkit --project=iphone-14 --workers=1",
    "check": "run-s typecheck lint test",
    "deploy": "run-s check build deploy:wrangler",
    "deploy:wrangler": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "uqr": "0.1.3",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
