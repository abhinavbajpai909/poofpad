{
  "name": "poofpad",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted, real-time shared text pad that disappears at a chosen expiry.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "run-s build:client dev:all",
    "dev:all": "run-p dev:client dev:worker",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "run-s types build:client",
    "build:client": "vite build",
    "types": "wrangler types",
    "typecheck": "run-s types typecheck:tsc",
    "typecheck:tsc": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "run-s build vitest",
    "vitest": "vitest run",
    "test:e2e": "playwright test",
    "check": "run-s typecheck lint test",
    "deploy": "run-s check build deploy:wrangler",
    "deploy:wrangler": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
